---
import DialogGambar from '../../components/DialogGambar.astro';
import JudulBagian from '../../components/JudulBagian.astro';
import JudulHalaman from '../../components/JudulHalaman.astro';
import Base from '../../layouts/Base.astro';
import { api } from '../../lib/api';

type Data = {
  sejarah: string | null;
  visi: string | null;
  misi: string[];
  fotoDiskominfo: string[];
};

const data = await api<Data>('/profil-dinas/tentang-kami', Astro.request);

// Admin membatasi foto kantor maksimal 3; susunannya menyesuaikan jumlah.
// Rasio foto bebas (potret/lanskap), jadi bingkai memotong dengan object-cover dan versi utuhnya dilihat lewat perbesar.
const foto = data.fotoDiskominfo.slice(0, 3);
const susunan = {
  // 1: satu bingkai lebar.
  1: { wadah: '', sel: ['aspect-4/3 sm:aspect-21/9'] },
  // 2: berdampingan 3:2 supaya tidak jadi dua kotak kembar.
  2: {
    wadah: 'sm:grid-cols-[3fr_2fr] sm:h-88 lg:h-104',
    sel: ['aspect-4/3 sm:aspect-auto', 'aspect-4/3 sm:aspect-auto'],
  },
  // 3: foto pertama besar di kiri, dua lainnya bertumpuk di kanan; di ponsel foto pertama melebar, dua sisanya berdampingan.
  3: {
    wadah: 'grid-cols-2 sm:grid-cols-[3fr_2fr] sm:grid-rows-2 sm:h-104 lg:h-120',
    sel: ['col-span-2 aspect-4/3 sm:col-span-1 sm:row-span-2 sm:aspect-auto', 'aspect-4/3 sm:aspect-auto', 'aspect-4/3 sm:aspect-auto'],
  },
}[foto.length];
---

<Base judul="Tentang Kami" deskripsi="Sejarah, visi, dan misi Diskominfo Kota Kendari.">
  <JudulHalaman
    judul="Tentang Kami"
    keterangan="Sejarah, visi, dan misi Dinas Komunikasi dan Informatika Kota Kendari."
    remah={[{ label: 'Profil Dinas' }, { label: 'Tentang Kami' }]}
  />

  <div class="wadah py-12">
    {susunan && (
      <div class:list={['mb-14 grid gap-3 sm:gap-4', susunan.wadah]} data-perbesar>
        {foto.map((f, i) => (
          <figure class:list={['group relative overflow-hidden rounded bg-biru-100 dark:bg-biru-900', susunan.sel[i]]}>
            <img
              src={f}
              alt={foto.length > 1 ? `Kantor Diskominfo Kota Kendari, foto ${i + 1} dari ${foto.length}` : 'Kantor Diskominfo Kota Kendari'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
              class="absolute inset-0 size-full object-cover transition duration-500 group-hover:scale-[1.03] focus-visible:-outline-offset-2 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
            />
          </figure>
        ))}
      </div>
    )}

    {data.sejarah && (
      <section class="mb-16">
        <JudulBagian judul="Sejarah Singkat" />
        <div class="prosa max-w-4xl" set:html={data.sejarah} />
      </section>
    )}

    <div class="grid gap-8 lg:grid-cols-2">
      {data.visi && (
        <section class="rounded bg-biru-800 motif-komdigi p-8 text-white bayangan-kartu">
          <h2 class="mb-4 text-xl font-bold">Visi</h2>
          <p class="text-lg leading-relaxed text-biru-100 italic">{data.visi}</p>
        </section>
      )}

      {data.misi.length > 0 && (
        <section class="rounded border border-garis bg-white p-8 dark:bg-malam-kartu bayangan-kartu">
          <h2 class="mb-5 text-xl font-bold text-biru-900 dark:text-white">Misi</h2>
          <ol class="space-y-4">
            {data.misi.map((m, i) => (
              <li class="flex gap-4">
                <span class="flex size-7 shrink-0 items-center justify-center rounded bg-biru-600 text-xs font-bold text-white">
                  {i + 1}
                </span>
                <p class="text-sm leading-relaxed text-teks-lembut">{m}</p>
              </li>
            ))}
          </ol>
        </section>
      )}
    </div>
  </div>

  <DialogGambar />
</Base>
