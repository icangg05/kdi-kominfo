---
import Base from '../layouts/Base.astro';

// Astro merender halaman ini untuk galat yang tidak tertangani (mis. API Laravel mati).
// Rincian galat sengaja tidak ditampilkan ke pengunjung.
---

<Base judul="Terjadi Kesalahan" noindex>
  <div class="wadah flex min-h-[50vh] flex-col items-center justify-center py-20 text-center">
    <p class="text-6xl font-extrabold text-biru-600 dark:text-biru-400">500</p>
    <h1 class="mt-4 text-2xl font-bold text-biru-900 dark:text-white">Terjadi kesalahan pada server</h1>
    <p class="mt-3 max-w-md text-teks-lembut">
      Halaman ini gagal dimuat karena gangguan di sisi kami. Silakan coba lagi beberapa saat lagi.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={Astro.url.pathname + Astro.url.search} class="rounded bg-biru-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-biru-700">
        Coba lagi
      </a>
      <a href="/" class="rounded border border-garis px-5 py-3 text-sm font-semibold text-biru-700 transition hover:bg-biru-50 dark:text-biru-200 dark:hover:bg-white/5">
        Kembali ke beranda
      </a>
    </div>
  </div>
</Base>
