---
import Ikon from '../components/Ikon.astro';
import JudulHalaman from '../components/JudulHalaman.astro';
import KosongAda from '../components/KosongAda.astro';
import Paginasi from '../components/Paginasi.astro';
import TabGaleri from '../components/TabGaleri.astro';
import Base from '../layouts/Base.astro';
import { api, query, tanggalPanjang, type Halaman } from '../lib/api';

type Foto = { judul: string; tanggal: string | null; gambar: string | null };

const page = Number(Astro.url.searchParams.get('page') ?? 1) || 1;
const daftar = await api<Halaman<Foto>>(`/galeri${query({ page })}`, Astro.request);
---

<Base judul="Galeri Foto" deskripsi="Dokumentasi foto kegiatan Diskominfo Kota Kendari.">
  <JudulHalaman
    judul="Galeri Foto"
    keterangan="Dokumentasi kegiatan dan layanan Diskominfo Kota Kendari."
    remah={[{ label: 'Galeri' }, { label: 'Foto' }]}
  />

  <div class="wadah py-12">
    <TabGaleri aktif="foto" />

    {daftar.data.length > 0 ? (
      <>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {daftar.data.map((f) => (
            <figure class="kartu-timbul group overflow-hidden">
              <div class="relative aspect-4/3 overflow-hidden bg-biru-100 dark:bg-biru-900">
                <span class="absolute inset-0 flex items-center justify-center text-biru-300 dark:text-biru-700" aria-hidden="true">
                  <Ikon nama="foto" class="size-10" />
                </span>
                {f.gambar && (
                  <img src={f.gambar} alt={f.judul} loading="lazy" onerror="this.remove()" class="relative size-full object-cover transition duration-500 group-hover:scale-105" />
                )}
              </div>
              <figcaption class="p-4">
                <p class="font-semibold leading-snug text-biru-950 dark:text-white">{f.judul}</p>
                <p class="mt-1 text-xs text-teks-lembut">{tanggalPanjang(f.tanggal)}</p>
              </figcaption>
            </figure>
          ))}
        </div>
        <Paginasi halaman={daftar.meta.page} halamanTerakhir={daftar.meta.lastPage} />
      </>
    ) : (
      <KosongAda pesan="Belum ada foto di galeri." />
    )}
  </div>
</Base>
