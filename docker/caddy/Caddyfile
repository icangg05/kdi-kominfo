{
	admin off

	# Di server, nginx (TLS) berdiri di depan Caddy. Tanpa ini Caddy menimpa
	# X-Forwarded-Proto jadi "http", Laravel mengira request-nya HTTP, dan
	# URL aset serta signed URL upload Livewire rusak.
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	# Berkas unggahan hanya disajikan, tidak pernah dieksekusi: php_server milik Octane
	# menjalankan .php apa pun di public/, termasuk lewat symlink public/storage.
	# Harus di atas handle lain — handle dengan matcher bernama dicek sesuai urutan tulis.
	@php_unggahan path_regexp (?i)^/storage/.*\.php
	handle @php_unggahan {
		respond 404
	}

	# Situs publik (Livewire), panel admin Filament, aset Vite, dan berkas unggahan
	# semuanya dilayani Laravel Octane.
	handle {
		reverse_proxy app:8000
	}
}
