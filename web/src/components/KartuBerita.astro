---
import Ikon from './Ikon.astro';
import { tanggalPanjang, type Berita } from '../lib/api';

interface Props {
  berita: Berita;
}

const { berita } = Astro.props;
---

<article class="group flex h-full flex-col overflow-hidden rounded border border-garis bg-white transition hover:border-biru-300 hover:shadow-[0_18px_36px_-20px_rgba(13,21,38,0.35)]">
  <a href={`/berita/${berita.slug}`} class="relative block aspect-16/9 overflow-hidden bg-papan" tabindex="-1" aria-hidden="true">
    <!-- Tanpa foto, papan menampilkan kategori seperti layar informasi. -->
    <span class="absolute inset-0 flex items-end justify-between gap-3 p-5">
      <span class="sempit text-2xl font-semibold leading-none text-white/90">{berita.kategori?.nama ?? 'Berita'}</span>
      <Ikon nama="foto" class="size-6 shrink-0 text-led" />
    </span>
    {berita.thumbnail && (
      <img
        src={berita.thumbnail}
        alt=""
        loading="lazy"
        onerror="this.remove()"
        class="relative size-full object-cover transition duration-500 group-hover:scale-[1.04]"
      />
    )}
  </a>

  <div class="flex flex-1 flex-col p-5">
    {berita.kategori && (
      <a
        href={`/berita?kategori=${berita.kategori.slug}`}
        class="mb-3 w-fit rounded bg-biru-50 px-2 py-1 text-xs font-semibold text-biru-700 hover:bg-biru-100"
      >
        {berita.kategori.nama}
      </a>
    )}

    <h3 class="mb-2 text-lg font-semibold leading-snug text-tinta">
      <a href={`/berita/${berita.slug}`} class="transition group-hover:text-biru-600">{berita.judul}</a>
    </h3>

    <p class="mb-4 line-clamp-3 text-sm text-teks-lembut">{berita.ringkasan}</p>

    <div class="mt-auto flex items-center gap-4 border-t border-garis pt-3 text-xs text-teks-lembut">
      <span class="flex items-center gap-1.5">
        <Ikon nama="kalender" class="size-4" />
        {tanggalPanjang(berita.tanggal)}
      </span>
      <span class="flex items-center gap-1.5">
        <Ikon nama="mata" class="size-4" />
        {berita.totalLihat.toLocaleString('id-ID')} kali dibaca
      </span>
    </div>
  </div>
</article>
