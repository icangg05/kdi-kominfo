---
import Ikon from '../../components/Ikon.astro';
import JudulHalaman from '../../components/JudulHalaman.astro';
import KosongAda from '../../components/KosongAda.astro';
import Paginasi from '../../components/Paginasi.astro';
import TabGaleri from '../../components/TabGaleri.astro';
import Base from '../../layouts/Base.astro';
import { api, query, tanggalPanjang, type Halaman } from '../../lib/api';

type Video = { judul: string; tanggal: string | null; tautan: string; youtubeId: string | null };

const page = Number(Astro.url.searchParams.get('page') ?? 1) || 1;
const daftar = await api<Halaman<Video>>(`/video${query({ page })}`, Astro.request);
---

<Base judul="Galeri Video" deskripsi="Dokumentasi video kegiatan Diskominfo Kota Kendari.">
  <JudulHalaman
    judul="Galeri Video"
    keterangan="Rekaman kegiatan dan informasi layanan Diskominfo Kota Kendari."
    remah={[{ label: 'Galeri', href: '/galeri' }, { label: 'Video' }]}
  />

  <div class="wadah py-12">
    <TabGaleri aktif="video" />

    {daftar.data.length > 0 ? (
      <>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {daftar.data.map((v) => (
            <article class="group relative aspect-video overflow-hidden rounded bg-biru-900 bayangan-kartu">
              {v.youtubeId && (
                <img src={`https://i.ytimg.com/vi/${v.youtubeId}/hqdefault.jpg`} alt="" loading="lazy" class="absolute inset-0 size-full object-cover transition duration-500 group-hover:scale-105" />
              )}
              <!-- Scrim sama dengan kartu foto: pekat di area teks supaya terbaca di thumbnail terang. -->
              <div class="absolute inset-x-0 bottom-0 flex items-center gap-3 bg-linear-to-t from-biru-950 via-biru-950/85 via-55% to-transparent p-4 pt-16 text-white">
                <span class="flex size-10 shrink-0 items-center justify-center rounded bg-white text-biru-700 transition group-hover:scale-110">
                  <Ikon nama="putar" class="size-5" />
                </span>
                <div class="min-w-0">
                  <h2 class="line-clamp-2 text-sm leading-snug font-semibold tracking-wide uppercase">{v.judul}</h2>
                  <p class="mt-1 text-xs text-biru-200">{tanggalPanjang(v.tanggal)}</p>
                </div>
              </div>
              <!-- Tautan menutup seluruh kartu dan ditaruh paling akhir supaya klik dan cincin fokusnya di atas keterangan.
                   Tanpa JavaScript tautan membuka YouTube; dengan JavaScript video diputar di dialog. -->
              <a href={v.tautan} target="_blank" rel="noopener noreferrer" class="absolute inset-0 focus-visible:-outline-offset-2" data-video={v.youtubeId ?? undefined} data-judul={v.judul} data-tanggal={tanggalPanjang(v.tanggal)}>
                <span class="sr-only">Putar video {v.judul}</span>
              </a>
            </article>
          ))}
        </div>
        <Paginasi halaman={daftar.meta.page} halamanTerakhir={daftar.meta.lastPage} />
      </>
    ) : (
      <KosongAda pesan="Belum ada video di galeri." />
    )}
  </div>

  <dialog id="dialog-video" aria-label="Pemutar video" class="dialog-halus m-auto w-[min(64rem,calc(100vw-2rem))] max-w-none overflow-visible bg-transparent p-0 [--pekat:0.92]">
    <div class="aspect-video overflow-hidden rounded bg-black" data-pemutar></div>
    <div class="pt-3 text-white">
      <p class="line-clamp-2 font-semibold leading-snug" data-judul></p>
      <p class="mt-1 text-sm text-biru-200" data-tanggal></p>
    </div>
    <!-- Tombol tutup di atas video supaya tidak menutupi kontrol YouTube di pojok kanan atas.
         autofocus: tanpa itu fokus jatuh ke iframe YouTube dan tombol Escape tertelan olehnya. -->
    <form method="dialog">
      <button autofocus class="absolute right-0 bottom-full mb-2 flex size-10 items-center justify-center rounded bg-biru-950/70 text-white transition hover:bg-biru-950" aria-label="Tutup video">
        <Ikon nama="silang" class="size-5" />
      </button>
    </form>
  </dialog>
</Base>

<script>
  // Pemutar YouTube baru dimuat saat diklik, supaya halaman tetap ringan di seluler.
  const dialogVideo = document.querySelector<HTMLDialogElement>('#dialog-video')!;
  const pemutar = dialogVideo.querySelector<HTMLElement>('[data-pemutar]')!;

  document.querySelectorAll<HTMLAnchorElement>('[data-video]').forEach((tautan) => {
    tautan.addEventListener('click', (e) => {
      e.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${tautan.dataset.video}?autoplay=1&rel=0`;
      iframe.title = tautan.dataset.judul ?? 'Video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.className = 'size-full';
      pemutar.replaceChildren(iframe);
      dialogVideo.setAttribute('aria-label', iframe.title);
      dialogVideo.querySelector('[data-judul]')!.textContent = iframe.title;
      dialogVideo.querySelector('[data-tanggal]')!.textContent = tautan.dataset.tanggal ?? '';
      dialogVideo.showModal();
    });
  });

  // Iframe dibuang saat dialog ditutup supaya suara video ikut berhenti; klik di luar video menutup dialog.
  dialogVideo.addEventListener('close', () => pemutar.replaceChildren());
  dialogVideo.addEventListener('click', (e) => e.target === dialogVideo && dialogVideo.close());
</script>
