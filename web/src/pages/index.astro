---
import Ikon from '../components/Ikon.astro';
import JudulBagian from '../components/JudulBagian.astro';
import KartuBerita from '../components/KartuBerita.astro';
import Base from '../layouts/Base.astro';
import { api, cadanganGambar, GAMBAR_DEFAULT, tanggalPanjang, type Berita, type Dokumen, type Halaman, type Kategori, asalSitus } from '../lib/api';
import { bidangDinas, layananUtama, tautanTerkait } from '../lib/konten';
import { layanan } from '../lib/layanan';

type Beranda = {
  sambutanKadis: string | null;
  taglineSambutan: string[];
  kadis: { nama: string; jabatan: string | null; foto: string | null } | null;
  galeri: { judul: string; tanggal: string | null; gambar: string | null }[];
  berita: Berita[];
  pengunjung: { hariIni: number; total: number };
};

const [data, global, arsip, dokumen, galeri] = await Promise.all([
  api<Beranda>('/beranda', Astro.request),
  api<{ kategoriBerita: Kategori[]; kategoriDokumen: Kategori[] }>('/pengaturan'),
  api<Halaman<Berita>>('/berita?page=2'),
  api<Halaman<Dokumen>>('/dokumen'),
  api<Halaman<unknown>>('/galeri'),
]);

const fotoKadis = data.kadis?.foto ?? null;

const angka = (n: number) => n.toLocaleString('id-ID');

// Tiga berita terbaru jadi sorotan; tiga berikutnya berjajar di dasar sorotan.
const sorotan = data.berita.slice(0, 3);
const deret = data.berita.slice(3, 6);
const darurat = layanan['telpon-darurat-112'];
---

<Base judul="Beranda">
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'GovernmentOrganization',
      name: 'Dinas Komunikasi dan Informatika Kota Kendari',
      alternateName: 'Diskominfo Kota Kendari',
      url: asalSitus(Astro.url),
      logo: `${asalSitus(Astro.url)}/img/kominfo-logo.webp`,
    })}
  />
  <h1 class="sr-only">Dinas Komunikasi dan Informatika Kota Kendari</h1>

  <!-- Sorotan berita -->
  <section class="relative isolate overflow-hidden bg-biru-950 text-white" aria-roledescription="carousel" aria-label="Sorotan berita" data-sorotan>
    {sorotan.length === 0 && (
      <img src="/img/latar-jaringan.webp" alt="" aria-hidden="true" width="2560" height="1440" fetchpriority="high" class="absolute inset-0 -z-20 size-full object-cover" />
    )}
    {sorotan.map((b, i) => (
      <img
        src={b.thumbnail ?? GAMBAR_DEFAULT}
        alt=""
        aria-hidden="true"
        fetchpriority={i === 0 ? 'high' : 'low'}
        onerror={cadanganGambar}
        class:list={['absolute inset-0 -z-20 size-full object-cover transition-opacity duration-700', i !== 0 && 'opacity-0']}
        data-latar
      />
    ))}
    <div class="absolute inset-0 -z-10 bg-linear-to-r from-biru-950 via-biru-900/90 to-biru-800/40"></div>

    <div class="wadah grid min-h-[26rem] content-center gap-8 py-12 lg:min-h-[32rem] lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:py-16">
      <div>
        {sorotan.length === 0 && (
          <div class="max-w-3xl">
            <p class="text-[2rem] leading-[1.12] font-bold tracking-tight text-balance sm:text-5xl">Dinas Komunikasi dan Informatika Kota Kendari</p>
            <p class="mt-4 max-w-2xl text-biru-100 lg:text-lg">Layanan informasi publik dan infrastruktur TIK Pemerintah Kota Kendari.</p>
          </div>
        )}

        {sorotan.map((b, i) => (
          <article class="max-w-3xl" hidden={i !== 0} aria-roledescription="slide" aria-label={`${i + 1} dari ${sorotan.length}`} data-slide>
            <p class="flex flex-wrap items-center gap-3 text-sm text-biru-100">
              {b.kategori && (
                <a href={`/berita?kategori=${b.kategori.slug}`} class="rounded bg-biru-600 px-2.5 py-1 text-xs font-semibold text-white transition hover:bg-biru-500">{b.kategori.nama}</a>
              )}
              <span>{tanggalPanjang(b.tanggal)}</span>
            </p>
            <h2 class="mt-4 line-clamp-3 text-2xl leading-tight font-bold tracking-tight text-balance sm:text-3xl lg:text-4xl">
              <a href={`/berita/${b.slug}`} class="decoration-2 underline-offset-4 hover:underline">{b.judul}</a>
            </h2>
            <p class="mt-4 line-clamp-2 max-w-2xl text-biru-100 lg:text-lg">{b.ringkasan}</p>
            <a href={`/berita/${b.slug}`} class="mt-7 inline-flex items-center gap-2 rounded bg-white px-5 py-3 text-sm font-semibold text-biru-800 transition hover:bg-biru-50 active:translate-y-px">
              Baca selengkapnya
              <Ikon nama="panah-kanan" class="size-4" />
            </a>
          </article>
        ))}
      </div>

      {sorotan.length > 1 && (
        <div class="flex gap-2 lg:flex-col" role="group" aria-label="Pilih sorotan">
          {sorotan.map((_, i) => (
            <button
              type="button"
              aria-label={`Tampilkan sorotan ${i + 1}`}
              aria-current={i === 0 ? 'true' : 'false'}
              class="flex size-10 items-center justify-center rounded border border-white/35 text-sm font-semibold tabular-nums transition hover:bg-white/10 aria-[current=true]:border-white aria-[current=true]:bg-white aria-[current=true]:text-biru-800"
              data-ke={i}
            >
              {i + 1}
            </button>
          ))}
        </div>
      )}
    </div>

    {deret.length > 0 && (
      <div class="border-t border-white/15 bg-biru-950/70">
        <ul class="wadah tanpa-scrollbar flex snap-x snap-mandatory scroll-px-4 gap-5 overflow-x-auto sm:grid sm:grid-cols-2 sm:gap-x-6 lg:grid-cols-4 lg:gap-0 lg:divide-x lg:divide-white/15">
          {deret.map((b) => (
            <li class="group relative flex w-[78%] shrink-0 snap-start items-center gap-3 py-4 sm:w-auto lg:px-5 lg:first:pl-0">
              <span class="size-14 shrink-0 overflow-hidden rounded bg-biru-700">
                <img src={b.thumbnail ?? GAMBAR_DEFAULT} alt="" loading="lazy" onerror={cadanganGambar} class="size-full object-cover" />
              </span>
              <div class="min-w-0">
                <h3 class="line-clamp-2 text-sm leading-snug font-semibold">
                  <a href={`/berita/${b.slug}`} class="after:absolute after:inset-0 group-hover:underline">{b.judul}</a>
                </h3>
                <p class="mt-1 text-xs text-biru-200">{tanggalPanjang(b.tanggal)}</p>
              </div>
            </li>
          ))}
          <li class="flex shrink-0 snap-start items-center py-4 pr-4 lg:px-5">
            <a href="/berita" class="group inline-flex items-center gap-3 text-sm font-semibold">
              <span class="flex size-9 items-center justify-center rounded border border-white/40 transition group-hover:bg-white group-hover:text-biru-800">
                <Ikon nama="panah-kanan" class="size-4" />
              </span>
              Semua berita
            </a>
          </li>
        </ul>
      </div>
    )}
  </section>

  <!-- Sambutan Kepala Dinas. Kiri: kartu identitas pimpinan (tautan ke profil) dengan pernik bentuk, yaitu
       bidang langit yang menjulur ke tepi layar, blok biru yang tergeser, dan dua siku bingkai. Kanan: kalimat
       teks sambutan (prosa seragam), lalu tagline. Gerak masuk mengikuti gulir, lihat <style> di bawah. -->
  {data.sambutanKadis && (
    <section class="sambutan relative isolate overflow-x-clip pt-14 lg:pt-20" aria-labelledby="judul-sambutan">
      <div class:list={['wadah grid items-start', data.kadis && 'lg:grid-cols-[17rem_minmax(0,1fr)] lg:gap-x-16 xl:grid-cols-[19rem_minmax(0,1fr)] xl:gap-x-20']}>
        <div class:list={[data.kadis && 'lg:col-start-2']}>
          <JudulBagian id="judul-sambutan" judul="Sambutan Kepala Dinas" />
        </div>

        {data.kadis && (
          <div class="group/potret relative mb-10 mr-3 lg:col-start-1 lg:row-span-2 lg:row-start-1 lg:mt-2 lg:mb-0">
            <div class="sambutan-bidang absolute top-20 right-1/3 -bottom-8 -left-[50vw] -z-10 hidden bg-langit lg:block" aria-hidden="true"></div>
            <span class="sambutan-siku absolute -top-4 -left-4 hidden size-12 border-t-2 border-l-2 border-biru-300 transition-[translate] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover/potret:-translate-1 lg:block dark:border-biru-700" aria-hidden="true"></span>
            <span class="sambutan-siku sambutan-siku-bawah absolute -right-7 -bottom-7 hidden size-12 border-r-2 border-b-2 border-biru-300 transition-[translate] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover/potret:translate-1 lg:block dark:border-biru-700" aria-hidden="true"></span>

            <a href="/profil-dinas/profil-pimpinan" class="relative block rounded">
              <span class="sambutan-geser absolute inset-0 translate-3 rounded bg-biru-600 transition-[translate] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover/potret:translate-4.5" aria-hidden="true"></span>
              <span class="sambutan-kartu relative grid grid-cols-[6.5rem_minmax(0,1fr)] overflow-hidden rounded bg-biru-800 text-white transition-[translate] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover/potret:-translate-1.5 group-active/potret:translate-0 lg:grid-cols-1">
                <span class="block overflow-hidden bg-biru-900">
                  <img
                    src={fotoKadis ?? GAMBAR_DEFAULT}
                    alt=""
                    loading="lazy"
                    onerror={cadanganGambar}
                    class="sambutan-foto aspect-4/5 size-full object-cover transition-[scale] duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover/potret:scale-105"
                  />
                </span>
                <span class="motif-komdigi flex items-center gap-4 p-4 lg:p-5">
                  <span class="min-w-0 flex-1">
                    <span class="sr-only">Profil pimpinan: </span>
                    <span class="block leading-snug font-bold text-balance">{data.kadis.nama}</span>
                    {data.kadis.jabatan && <span class="mt-1 block text-sm text-biru-200">{data.kadis.jabatan}</span>}
                  </span>
                  <span class="flex size-9 shrink-0 items-center justify-center rounded border border-white/40 transition group-hover/potret:border-white group-hover/potret:bg-white group-hover/potret:text-biru-800" aria-hidden="true">
                    <Ikon nama="panah-kanan" class="size-4 transition-[translate] duration-300 group-hover/potret:translate-x-0.5" />
                  </span>
                </span>
              </span>
            </a>
          </div>
        )}

        <div class:list={[data.kadis && 'lg:col-start-2']}>
          <div class="relative isolate lg:mt-2">
            <span class="sambutan-kutip pointer-events-none absolute -top-8 -left-1 -z-10 text-[8rem] leading-none font-bold text-biru-100 select-none lg:-top-10 lg:-left-7 lg:text-[10rem] dark:text-biru-900" aria-hidden="true">“</span>
            <div class="sambutan-teks prosa max-w-[65ch] *:last:mb-0 lg:text-lg" set:html={data.sambutanKadis} />
          </div>

          {data.taglineSambutan.length > 0 && (
            <ul class="mt-9 flex flex-wrap gap-2" aria-label="Tagline Diskominfo Kota Kendari">
              {data.taglineSambutan.map((t, i) => (
                <li
                  class="sambutan-tagline rounded border border-biru-200 bg-biru-50 px-3.5 py-2 text-xs font-bold tracking-wide text-biru-800 uppercase dark:border-biru-800 dark:bg-biru-900/50 dark:text-biru-100"
                  style={`--mulai: ${40 + i * 6}%; --akhir: ${62 + i * 6}%`}
                >
                  {t}
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Layanan -->
  <section class="py-14 lg:py-20" aria-labelledby="judul-layanan">
    <div class="wadah">
      <div class="rounded bg-linear-to-br from-biru-900 via-biru-700 to-biru-600 px-5 py-8 text-white shadow-[0_24px_48px_-28px_rgba(7,31,61,0.7)] sm:px-8 lg:px-10 lg:py-10">
        <h2 id="judul-layanan" class="text-xl font-bold text-balance lg:text-2xl">Layanan Diskominfo untuk Perangkat Daerah dan Warga</h2>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4 lg:gap-4">
          {layananUtama.map((l) => (
            <li class="flex">
              <a href={`/layanan/${l.slug}`} class="group flex w-full flex-col rounded border border-white/15 bg-white/10 p-5 transition hover:-translate-y-1 hover:border-white/35 hover:bg-white/15">
                <span class:list={['flex size-12 items-center justify-center rounded', l.slug === 'telpon-darurat-112' ? 'bg-darurat text-white' : 'bg-white text-biru-700']}>
                  <Ikon nama={l.ikon} class="size-6" />
                </span>
                <h3 class="mt-5 text-sm font-bold tracking-wide uppercase">{l.judul}</h3>
                <p class="mt-2 text-sm leading-relaxed text-biru-100">{l.ringkas}</p>
                <span class="mt-auto pt-6">
                  <span class="flex size-9 items-center justify-center rounded border border-white/40 transition group-hover:bg-white group-hover:text-biru-700">
                    <Ikon nama="panah-kanan" class="size-4" />
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Pencarian dokumen publik -->
  <section class="pb-14 lg:pb-20" aria-labelledby="judul-cari-dokumen">
    <div class="wadah">
      <div class="grid overflow-hidden rounded border border-garis lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
        <div class="flex items-center gap-5 bg-langit p-6 sm:p-8 lg:p-10">
          <span class="flex size-16 shrink-0 items-center justify-center rounded bg-biru-600 text-white lg:size-20">
            <Ikon nama="berkas" class="size-8 lg:size-10" />
          </span>
          <div>
            <p class="text-2xl leading-tight font-bold text-biru-900 lg:text-3xl dark:text-white">Dokumen Publik</p>
            <p class="mt-1 text-sm text-teks-lembut">Laporan, peraturan, dan dokumen resmi yang dapat diunduh bebas.</p>
          </div>
        </div>

        <div class="bg-biru-800 p-6 text-white sm:p-8 lg:p-10">
          <h2 id="judul-cari-dokumen" class="text-2xl font-bold">Telusuri {angka(dokumen.meta.total)} dokumen publik</h2>
          <p class="mt-1 text-sm text-biru-200">Ketik judul dokumen yang Anda cari.</p>
          <form method="get" action="/dokumen" role="search" class="relative mt-5">
            <label for="cari-dokumen" class="sr-only">Cari dokumen</label>
            <input id="cari-dokumen" name="search" type="search" autocomplete="off" placeholder="Judul dokumen" class="h-12 w-full rounded bg-white pr-14 pl-4 text-teks placeholder:text-teks-lembut focus:outline-2 focus:outline-biru-300 dark:bg-biru-950" />
            <button type="submit" class="absolute top-1.5 right-1.5 flex size-9 items-center justify-center rounded bg-biru-600 transition hover:bg-biru-700" aria-label="Cari dokumen">
              <Ikon nama="cari" class="size-5" />
            </button>
          </form>
          {global.kategoriDokumen.length > 0 && (
            <p class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
              <span class="text-biru-200">Kategori:</span>
              {global.kategoriDokumen.map((k) => (
                <a href={`/dokumen?kategori=${k.slug}`} class="font-medium underline decoration-white/30 underline-offset-4 transition hover:decoration-white">{k.nama}</a>
              ))}
            </p>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Profil dan bidang dinas -->
  <section class="relative isolate overflow-hidden bg-biru-950 py-16 text-white lg:py-24" aria-labelledby="judul-profil">
    <img src="/img/bg-earth.webp" alt="" aria-hidden="true" loading="lazy" class="absolute inset-y-0 right-0 -z-10 h-full w-full object-cover opacity-40 lg:w-3/5" />
    <div class="absolute inset-0 -z-10 bg-linear-to-r from-biru-950 via-biru-950/85 to-biru-950/10"></div>
    <div class="kisi-titik absolute inset-0 -z-10 opacity-60" aria-hidden="true"></div>

    <div class="wadah">
      <div class="max-w-2xl">
        <h2 id="judul-profil" class="text-3xl leading-tight font-bold text-balance lg:text-[2.75rem]">Transformasi Digital Pemerintah Kota Kendari</h2>
        <p class="mt-5 max-w-[60ch] leading-relaxed text-biru-100 lg:text-lg">
          Diskominfo Kota Kendari mengelola informasi publik, menyelenggarakan pemerintahan berbasis elektronik,
          serta menyediakan infrastruktur TIK dan persandian bagi Pemerintah Kota Kendari.
        </p>
        <a href="/profil-dinas/tentang-kami" class="group mt-7 inline-flex items-center gap-3 text-sm font-semibold">
          <span class="flex size-9 items-center justify-center rounded border border-white/40 transition group-hover:bg-white group-hover:text-biru-900">
            <Ikon nama="panah-kanan" class="size-4" />
          </span>
          Baca selengkapnya
        </a>
      </div>

      <ul class="mt-14 grid gap-8 border-t border-white/15 pt-10 sm:grid-cols-2 lg:mt-20 lg:grid-cols-4 lg:gap-6">
        {bidangDinas.map((b) => (
          <li class="flex gap-4">
            <span class="flex size-12 shrink-0 items-center justify-center rounded bg-biru-600/50 text-biru-100 ring-1 ring-white/20">
              <Ikon nama={b.ikon} class="size-6" />
            </span>
            <div>
              <h3 class="text-sm leading-snug font-bold tracking-wide uppercase">{b.judul}</h3>
              <p class="mt-2 text-sm leading-relaxed text-biru-200">{b.isi}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Galeri dan angka -->
  <section class="py-14 lg:py-20" aria-labelledby="judul-galeri">
    <div class="wadah">
      <JudulBagian id="judul-galeri" judul="Kegiatan dan Informasi Publik" tautan={{ label: 'Lihat lainnya', href: '/galeri' }} />

      <div class="grid gap-4 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
        <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:gap-4">
          {data.galeri.slice(0, 5).map((g) => (
            <li>
              <figure class="group relative aspect-4/3 overflow-hidden rounded bg-biru-900">
                <img src={g.gambar ?? GAMBAR_DEFAULT} alt={g.judul} loading="lazy" onerror={cadanganGambar} class="absolute inset-0 size-full object-cover transition duration-500 group-hover:scale-105" />
                <figcaption class="absolute inset-x-0 bottom-0 bg-linear-to-t from-biru-950 via-biru-950/70 to-transparent p-3 pt-10 text-white">
                  <p class="line-clamp-2 text-xs leading-snug font-semibold tracking-wide uppercase">{g.judul}</p>
                  <p class="mt-1 text-[11px] text-biru-200">{tanggalPanjang(g.tanggal)}</p>
                </figcaption>
              </figure>
            </li>
          ))}
          <li>
            <a href="/galeri" class="group flex aspect-4/3 flex-col justify-between rounded border border-garis bg-langit p-4 text-biru-800 transition hover:border-biru-300 hover:bg-biru-100 dark:text-biru-100 dark:hover:border-biru-700 dark:hover:bg-biru-900">
              <Ikon nama="foto" class="size-7" />
              <span>
                <span class="block text-3xl font-bold tabular-nums">{angka(galeri.meta.total)}</span>
                <span class="mt-1 flex items-center gap-2 text-sm font-semibold">
                  Foto kegiatan
                  <Ikon nama="panah-kanan" class="size-4 transition group-hover:translate-x-1" />
                </span>
              </span>
            </a>
          </li>
        </ul>

        <div class="flex flex-col rounded bg-toska p-6 text-white lg:p-8">
          <h3 class="text-sm font-semibold">Total kunjungan situs</h3>
          <p class="mt-2 text-6xl leading-none font-bold tracking-tight tabular-nums lg:text-7xl">{angka(data.pengunjung.total)}</p>
          <p class="mt-3 text-sm">{angka(data.pengunjung.hariIni)} pengunjung hari ini</p>
          <dl class="mt-8 divide-y divide-white/20 border-t border-white/20 text-sm lg:mt-auto">
            <div class="flex items-baseline justify-between gap-4 py-3">
              <dt>Berita diterbitkan</dt>
              <dd class="text-xl font-bold tabular-nums">{angka(arsip.meta.total)}</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 py-3">
              <dt>Dokumen publik</dt>
              <dd class="text-xl font-bold tabular-nums">{angka(dokumen.meta.total)}</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 pt-3">
              <dt>Foto kegiatan</dt>
              <dd class="text-xl font-bold tabular-nums">{angka(galeri.meta.total)}</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- Kabar lainnya: geser mendatar -->
  {arsip.data.length > 0 && (
    <section class="bg-langit py-14 lg:py-20" aria-labelledby="judul-kabar" data-geser>
      <div class="wadah">
        <div class="mb-6 flex flex-wrap items-end justify-between gap-4 lg:mb-8">
          <h2 id="judul-kabar" class="text-lg font-bold tracking-wide text-biru-950 uppercase lg:text-xl dark:text-white">Kabar Diskominfo Kota Kendari</h2>
          <div class="flex items-center gap-2">
            <a href="/berita" class="mr-3 text-sm font-semibold text-biru-600 hover:text-biru-800 dark:text-biru-300 dark:hover:text-white">Semua berita</a>
            <button type="button" class="flex size-10 items-center justify-center rounded border border-biru-300 bg-white text-biru-700 transition hover:border-biru-600 hover:bg-biru-600 hover:text-white dark:border-biru-700 dark:bg-malam-kartu dark:text-biru-100" aria-label="Geser ke kiri" data-arah="-1">
              <Ikon nama="panah-kiri" class="size-4" />
            </button>
            <button type="button" class="flex size-10 items-center justify-center rounded border border-biru-300 bg-white text-biru-700 transition hover:border-biru-600 hover:bg-biru-600 hover:text-white dark:border-biru-700 dark:bg-malam-kartu dark:text-biru-100" aria-label="Geser ke kanan" data-arah="1">
              <Ikon nama="panah-kanan" class="size-4" />
            </button>
          </div>
        </div>

        <ul class="tanpa-scrollbar -mx-4 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto px-4 pb-2 lg:mx-0 lg:scroll-px-0 lg:px-0" data-jalur>
          {arsip.data.map((b) => (
            <li class="w-[78%] shrink-0 snap-start sm:w-[calc((100%-1rem)/2)] lg:w-[calc((100%-3rem)/4)]">
              <KartuBerita berita={b} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Dokumen terbaru, dengan topik berita dan Kendari Siaga 112 di bilah samping -->
  <section class="py-14 lg:py-20">
    <div class:list={['wadah grid gap-12', dokumen.data.length > 0 && 'lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]']}>
      {dokumen.data.length > 0 && (
        <div>
          <JudulBagian id="judul-dokumen-terbaru" judul="Dokumen Publik Terbaru" tautan={{ label: 'Lihat lainnya', href: '/dokumen' }} />
          <ul class="grid gap-4 max-sm:[&>li:nth-child(n+4)]:hidden sm:grid-cols-2 xl:grid-cols-3">
            {dokumen.data.map((d) => (
              <li class="kartu-timbul group relative flex flex-col p-5">
                <div class="flex items-start justify-between gap-3">
                  <span class="flex h-12 w-10 items-center justify-center rounded bg-biru-600 text-[11px] font-bold text-white uppercase">{d.ekstensi || 'file'}</span>
                  <span class="text-xs text-teks-lembut tabular-nums">{angka(d.totalUnduhan)} unduhan</span>
                </div>
                <h3 class="mt-4 line-clamp-2 font-semibold leading-snug text-biru-950 dark:text-white">{d.judul}</h3>
                {d.kategori && <p class="mt-1 text-xs font-semibold text-biru-600 dark:text-biru-300">{d.kategori.nama}</p>}
                <p class="mt-2 line-clamp-2 text-sm text-teks-lembut">{d.deskripsi}</p>
                <a href={d.unduh} class="mt-auto inline-flex items-center gap-2 pt-4 text-sm font-semibold text-biru-600 after:absolute after:inset-0 hover:text-biru-800 dark:text-biru-300 dark:hover:text-white">
                  <Ikon nama="unduh" class="size-4" />
                  Unduh dokumen
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <aside class="space-y-6">
        {global.kategoriBerita.length > 0 && (
          <section class="rounded bg-linear-to-br from-nila to-biru-700 p-6 text-white" aria-labelledby="judul-topik">
            <h2 id="judul-topik" class="text-lg font-bold tracking-wide uppercase">Pilih Topik Berita</h2>
            <p class="mt-2 text-sm text-biru-100">Baca berita Diskominfo Kota Kendari sesuai topik yang Anda minati.</p>
            <ul class="mt-5 flex flex-wrap gap-2">
              {global.kategoriBerita.map((k) => (
                <li>
                  <a href={`/berita?kategori=${k.slug}`} class="group inline-flex items-center gap-1.5 rounded border border-white/25 bg-white/10 px-3 py-1.5 text-sm font-medium transition hover:bg-white hover:text-nila">
                    {k.nama}
                    <Ikon nama="panah-kanan" class="size-3.5 transition group-hover:translate-x-0.5" />
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section class="motif-komdigi rounded bg-biru-900 p-6 text-white" aria-labelledby="judul-darurat">
          <div class="flex items-center gap-3">
            <span class="flex size-11 items-center justify-center rounded bg-darurat">
              <Ikon nama="telepon" class="size-5" />
            </span>
            <h2 id="judul-darurat" class="text-lg font-bold">Kendari Siaga 112</h2>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-biru-100">{darurat.ringkas}</p>
          <ul class="mt-5 space-y-2">
            <li>
              <a href="tel:112" class="flex items-center justify-between rounded bg-white px-4 py-3 text-sm font-semibold text-biru-900 transition hover:bg-biru-50">
                Hubungi 112
                <Ikon nama="telepon" class="size-4" />
              </a>
            </li>
            <li>
              <a href="/layanan/telpon-darurat-112" class="flex items-center justify-between rounded border border-white/25 px-4 py-3 text-sm font-semibold transition hover:bg-white/10">
                Tentang layanan 112
                <Ikon nama="panah-kanan" class="size-4" />
              </a>
            </li>
          </ul>
        </section>
      </aside>
    </div>
  </section>

  <!-- Tautan terkait -->
  <nav class="border-t border-garis bg-white py-8 dark:bg-malam" aria-label="Tautan terkait">
    <ul class="wadah grid grid-cols-1 gap-x-6 gap-y-3 sm:grid-cols-2 lg:flex lg:items-center lg:justify-between">
      {tautanTerkait.map((t) => (
        <li>
          <a href={t.href} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-2 text-sm font-semibold text-biru-800 transition hover:text-biru-600 dark:text-biru-100 dark:hover:text-white">
            {t.label}
            <Ikon nama="panah-kanan" class="size-3.5 -rotate-45 transition group-hover:translate-x-0.5" />
          </a>
        </li>
      ))}
    </ul>
  </nav>
</Base>

<style>
  /* Sambutan: satu gerak masuk yang disetir gulir (tanpa JS). Semua memakai timeline view milik section,
     jadi urutannya terjaga: bidang menyapu, kartu terbuka dari atas sambil foto mengendap, blok biru keluar
     dari balik kartu, siku merapat, lalu teks sambutan dan tagline menyusul. Keyframe memakai `transform`,
     sedangkan efek hover memakai properti `translate`/`scale`, jadi keduanya bertumpuk dan tidak saling timpa.
     Peramban tanpa animation-timeline dan pengguna yang memilih gerak dikurangi melihat keadaan akhir yang statis. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .sambutan {
        view-timeline-name: --sambutan;
      }

      .sambutan-bidang,
      .sambutan-kartu,
      .sambutan-foto,
      .sambutan-geser,
      .sambutan-siku,
      .sambutan-kutip,
      .sambutan-teks,
      .sambutan-tagline {
        animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
        animation-fill-mode: both;
        animation-timeline: --sambutan;
      }

      .sambutan-bidang {
        transform-origin: left;
        animation-name: sambutan-sapu;
        animation-range: entry 0% entry 75%;
      }

      .sambutan-kartu {
        animation-name: sambutan-buka;
        animation-range: entry 5% entry 55%;
      }

      .sambutan-foto {
        animation-name: sambutan-endap;
        animation-range: entry 5% entry 70%;
      }

      .sambutan-geser {
        animation-name: sambutan-keluar;
        animation-range: entry 30% entry 75%;
      }

      .sambutan-siku {
        animation-name: sambutan-rapat;
        animation-range: entry 35% entry 80%;
      }

      .sambutan-siku-bawah {
        animation-name: sambutan-rapat-bawah;
      }

      .sambutan-kutip {
        animation-name: sambutan-kutip;
        animation-range: entry 10% entry 60%;
      }

      .sambutan-teks {
        animation-name: sambutan-naik;
        animation-range: entry 15% entry 60%;
      }

      .sambutan-tagline {
        animation-name: sambutan-naik;
        animation-range: entry var(--mulai) entry var(--akhir);
      }
    }
  }

  @keyframes sambutan-sapu {
    from { transform: scaleX(0); }
  }

  @keyframes sambutan-buka {
    from { clip-path: inset(0 0 100% 0 round 4px); }
    to { clip-path: inset(0 0 0 0 round 4px); }
  }

  @keyframes sambutan-endap {
    from { transform: scale(1.18); }
  }

  /* Blok biru mulai tepat di balik kartu (menetralkan geser 0.75rem dari kelas translate-3), lalu keluar. */
  @keyframes sambutan-keluar {
    from { transform: translate(-0.75rem, -0.75rem); }
  }

  @keyframes sambutan-rapat {
    from { opacity: 0; transform: translate(-1rem, -1rem); }
  }

  @keyframes sambutan-rapat-bawah {
    from { opacity: 0; transform: translate(1rem, 1rem); }
  }

  @keyframes sambutan-kutip {
    from { opacity: 0; transform: translateY(1.5rem) scale(0.85); }
  }

  @keyframes sambutan-naik {
    from { opacity: 0; transform: translateY(1rem); }
  }
</style>

<script>
  const kurangiGerak = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Sorotan: tombol nomor memilih slide; bergilir tiap 7 detik (tetap jalan saat kursor di atasnya) kecuali fokus keyboard atau gerak dikurangi.
  const sorotan = document.querySelector<HTMLElement>('[data-sorotan]');

  if (sorotan) {
    const slide = [...sorotan.querySelectorAll<HTMLElement>('[data-slide]')];
    const tombol = [...sorotan.querySelectorAll<HTMLButtonElement>('[data-ke]')];
    const latar = [...sorotan.querySelectorAll<HTMLElement>('[data-latar]')];
    let aktif = 0;
    let giliran: ReturnType<typeof setInterval> | undefined;

    const tampil = (n: number) => {
      aktif = (n + slide.length) % slide.length;
      slide.forEach((s, i) => (s.hidden = i !== aktif));
      latar.forEach((l, i) => l.classList.toggle('opacity-0', i !== aktif));
      tombol.forEach((t, i) => t.setAttribute('aria-current', String(i === aktif)));
    };

    const jalan = () => {
      clearInterval(giliran);
      if (!kurangiGerak && slide.length > 1) giliran = setInterval(() => tampil(aktif + 1), 7000);
    };

    tombol.forEach((t, i) => t.addEventListener('click', () => { tampil(i); jalan(); }));
    sorotan.addEventListener('focusin', () => clearInterval(giliran));
    sorotan.addEventListener('focusout', jalan);
    jalan();
  }

  // Carousel kabar: tombol panah menggeser sejauh satu layar jalur.
  document.querySelectorAll<HTMLElement>('[data-geser]').forEach((wadah) => {
    const jalur = wadah.querySelector<HTMLElement>('[data-jalur]');
    wadah.querySelectorAll<HTMLButtonElement>('[data-arah]').forEach((b) =>
      b.addEventListener('click', () =>
        jalur?.scrollBy({ left: Number(b.dataset.arah) * jalur.clientWidth * 0.9, behavior: kurangiGerak ? 'auto' : 'smooth' }),
      ),
    );
  });
</script>
