---
import Ikon from './Ikon.astro';

/** Judul bagian gaya Komdigi: huruf kapital tebal, tautan "Lihat lainnya" di kanan. */
interface Props {
  judul: string;
  keterangan?: string;
  tautan?: { label: string; href: string };
  id?: string;
  terang?: boolean;
}

const { judul, keterangan, tautan, id, terang = false } = Astro.props;
---

<div class="mb-6 flex flex-wrap items-end justify-between gap-x-8 gap-y-3 lg:mb-8">
  <div>
    <h2 id={id} class:list={['text-lg font-bold tracking-wide text-balance uppercase lg:text-xl', terang ? 'text-white' : 'text-biru-950 dark:text-white']}>{judul}</h2>
    {keterangan && <p class:list={['mt-2 max-w-[62ch] text-sm', terang ? 'text-biru-100' : 'text-teks-lembut']}>{keterangan}</p>}
  </div>

  {tautan && (
    <a href={tautan.href} class:list={['group inline-flex items-center gap-2.5 text-sm font-semibold', terang ? 'text-white' : 'text-biru-600 hover:text-biru-800 dark:text-biru-300 dark:hover:text-white']}>
      <span class:list={['flex size-7 items-center justify-center rounded border transition', terang ? 'border-white/40 group-hover:bg-white group-hover:text-biru-800' : 'border-biru-300 dark:border-biru-700 group-hover:border-biru-600 group-hover:bg-biru-600 group-hover:text-white']}>
        <Ikon nama="panah-kanan" class="size-3.5" />
      </span>
      {tautan.label}
    </a>
  )}
</div>
