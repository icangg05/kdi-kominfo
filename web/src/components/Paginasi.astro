---
import Ikon from './Ikon.astro';

interface Props {
  halaman: number;
  halamanTerakhir: number;
  /** Query string dasar tanpa parameter `page`, mis. `?kategori=umum`. */
  dasar?: Record<string, string>;
}

const { halaman, halamanTerakhir, dasar = {} } = Astro.props;

const tautan = (n: number) => {
  const q = new URLSearchParams(dasar);
  if (n > 1) q.set('page', String(n));
  const s = q.toString();
  return s ? `?${s}` : Astro.url.pathname;
};

// Tampilkan maksimal 5 nomor di sekitar halaman aktif.
const mulai = Math.max(1, Math.min(halaman - 2, halamanTerakhir - 4));
const nomor = Array.from({ length: Math.min(5, halamanTerakhir) }, (_, i) => mulai + i)
  .filter((n) => n <= halamanTerakhir);
---

<!--
  Di layar sempit "Sebelumnya/Berikutnya" jadi ikon dan kotak nomor mengecil, supaya 7 tombol muat
  di lebar 320px. flex-wrap sebagai pengaman: lebih baik turun baris daripada meluber ke samping.
-->
{halamanTerakhir > 1 && (
  <nav class="mt-10 flex flex-wrap items-center justify-center gap-1.5 sm:gap-2" aria-label="Paginasi">
    <a
      href={tautan(halaman - 1)}
      class:list={[
        'flex min-h-9 min-w-9 items-center justify-center rounded border border-biru-200 text-sm transition sm:px-3 sm:py-2 dark:border-biru-800',
        halaman <= 1 ? 'pointer-events-none opacity-40' : 'hover:bg-biru-50 dark:hover:bg-white/5',
      ]}
      aria-disabled={halaman <= 1}
      aria-label="Halaman sebelumnya"
    >
      <Ikon nama="chevron" class="size-4 rotate-90 sm:hidden" />
      <span class="max-sm:hidden">Sebelumnya</span>
    </a>

    {nomor.map((n) => (
      <a
        href={tautan(n)}
        aria-current={n === halaman ? 'page' : undefined}
        class:list={[
          'flex min-h-9 min-w-9 items-center justify-center rounded border px-2 text-sm tabular-nums transition sm:min-w-10 sm:px-3 sm:py-2',
          n === halaman
            ? 'border-biru-600 bg-biru-600 font-semibold text-white'
            : 'border-biru-200 hover:bg-biru-50 dark:border-biru-800 dark:hover:bg-white/5',
        ]}
      >
        {n}
      </a>
    ))}

    <a
      href={tautan(halaman + 1)}
      class:list={[
        'flex min-h-9 min-w-9 items-center justify-center rounded border border-biru-200 text-sm transition sm:px-3 sm:py-2 dark:border-biru-800',
        halaman >= halamanTerakhir ? 'pointer-events-none opacity-40' : 'hover:bg-biru-50 dark:hover:bg-white/5',
      ]}
      aria-disabled={halaman >= halamanTerakhir}
      aria-label="Halaman berikutnya"
    >
      <Ikon nama="chevron" class="size-4 -rotate-90 sm:hidden" />
      <span class="max-sm:hidden">Berikutnya</span>
    </a>
  </nav>
)}
