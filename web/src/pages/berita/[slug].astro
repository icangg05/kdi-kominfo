---
import Ikon from '../../components/Ikon.astro';
import JudulHalaman from '../../components/JudulHalaman.astro';
import KartuBerita from '../../components/KartuBerita.astro';
import Base from '../../layouts/Base.astro';
import { api, asalSitus, cadanganGambar, GAMBAR_DEFAULT, tanggalPanjang, type Berita } from '../../lib/api';

type Detail = Berita & { konten: string; sumber: string | null; lainnya: Berita[] };

const { slug } = Astro.params;

let berita: Detail;

try {
  berita = await api<Detail>(`/berita/${slug}`, Astro.request);
} catch {
  return new Response(null, { status: 404, statusText: 'Berita tidak ditemukan' });
}

const asal = asalSitus(Astro.url);
const tautan = `${asal}/berita/${berita.slug}`;
const u = encodeURIComponent(tautan);
const j = encodeURIComponent(berita.judul);

const bagikan = [
  { nama: 'WhatsApp', ikon: 'whatsapp', href: `https://wa.me/?text=${j}%20${u}` },
  { nama: 'Facebook', ikon: 'facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${u}` },
  { nama: 'X', ikon: 'x', href: `https://x.com/intent/post?text=${j}&url=${u}` },
  { nama: 'Telegram', ikon: 'telegram', href: `https://t.me/share/url?url=${u}&text=${j}` },
] as const;

// `<` di-escape supaya judul berisi "</script>" tidak bisa keluar dari blok JSON-LD.
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: berita.judul,
  description: berita.ringkasan,
  image: [new URL(berita.thumbnail || '/img/og-default.jpg', asal + '/').href],
  datePublished: berita.tanggal,
  mainEntityOfPage: tautan,
  articleSection: berita.kategori?.nama,
  author: { '@type': 'GovernmentOrganization', name: 'Diskominfo Kota Kendari', url: asal },
  publisher: {
    '@type': 'GovernmentOrganization',
    name: 'Dinas Komunikasi dan Informatika Kota Kendari',
    logo: { '@type': 'ImageObject', url: `${asal}/img/kominfo-logo.webp` },
  },
}).replace(/</g, '\\u003c');
---

<Base judul={berita.judul} deskripsi={berita.ringkasan} gambar={berita.thumbnail} jenis="article" terbit={berita.tanggal}>
  <script type="application/ld+json" slot="head" set:html={jsonLd} />
  <article>
    <JudulHalaman judul={berita.judul} remah={[{ label: 'Berita', href: '/berita' }]}>
      <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm text-biru-200">
        {berita.kategori && (
          <a href={`/berita?kategori=${berita.kategori.slug}`} class="rounded bg-white/15 px-3 py-1 text-xs font-semibold text-white hover:bg-white/25">
            {berita.kategori.nama}
          </a>
        )}
        <span class="flex items-center gap-2"><Ikon nama="kalender" class="size-4" />{tanggalPanjang(berita.tanggal)}</span>
        <span class="flex items-center gap-2"><Ikon nama="mata" class="size-4" />{berita.totalLihat} kali dibaca</span>
      </div>
      <!-- Ruang untuk sampul yang menumpang ke pita judul. -->
      {berita.thumbnail && <div class="h-10 lg:h-14" aria-hidden="true"></div>}
    </JudulHalaman>

    <div class="wadah py-12">
      <div class="grid gap-12 lg:grid-cols-[1fr_320px]">
        <div data-perbesar>
          <!-- Sampul menumpang ke pita judul dengan bingkai, supaya tidak terbaca sebagai foto isi berita.
               Gambar utuh (contain) di depan salinannya yang diburamkan: foto potret tidak terpotong. -->
          {berita.thumbnail && (
            <figure class="relative z-10 -mt-[5.5rem] mb-10 aspect-16/9 overflow-hidden rounded bg-biru-950 shadow-[0_24px_48px_-28px_rgba(7,31,61,0.7)] ring-4 ring-white lg:-mt-[6.5rem] dark:ring-malam">
              <img src={berita.thumbnail} alt="" aria-hidden="true" class="absolute inset-0 size-full scale-110 object-cover opacity-60 blur-2xl" />
              <img src={berita.thumbnail} alt={berita.judul} fetchpriority="high" class="relative size-full object-contain" />
            </figure>
          )}
          <div class="prosa max-w-none" set:html={berita.konten} />
          {berita.sumber && (
            <p class="mt-6 text-sm text-teks-lembut">
              Sumber:{' '}
              <a href={berita.sumber} target="_blank" rel="noopener" class="font-semibold text-biru-600 hover:underline dark:text-biru-300">Portal Berita Kota Kendari</a>
            </p>
          )}

          <div class="mt-10 flex flex-wrap items-center gap-3 border-t border-garis pt-6">
            <p class="mr-2 text-sm font-semibold text-biru-900 dark:text-white">Bagikan berita ini</p>
            {bagikan.map((b) => (
              <a
                href={b.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Bagikan ke ${b.nama}`}
                title={b.nama}
                class="grid size-10 place-items-center rounded bg-biru-50 text-biru-700 transition-colors hover:bg-biru-600 hover:text-white active:scale-[0.97] dark:bg-malam-kartu dark:text-biru-200 dark:hover:bg-biru-600 dark:hover:text-white"
              >
                <Ikon nama={b.ikon} class="size-4.5" />
              </a>
            ))}
            <button
              type="button"
              data-salin={tautan}
              class="flex h-10 items-center gap-2 rounded border border-garis px-3 text-sm font-medium text-biru-700 transition-colors hover:border-biru-600 hover:text-biru-600 active:scale-[0.97] dark:text-biru-200 dark:hover:text-white"
            >
              <Ikon nama="tautan" class="size-4.5" />
              <span aria-live="polite">Salin tautan</span>
            </button>
          </div>
        </div>

        <!-- Menempel tepat di bawah nav desktop (52px) selagi isi berita digulir. -->
        {berita.lainnya.length > 0 && (
          <aside class="lg:sticky lg:top-[76px] lg:self-start">
            <h2 class="mb-5 border-b border-garis pb-3 font-bold text-biru-900 dark:text-white">Berita Lainnya</h2>
            <ul class="space-y-5">
              {berita.lainnya.map((b) => (
                <li class="flex gap-4">
                  <a href={`/berita/${b.slug}`} class="size-20 shrink-0 overflow-hidden rounded bg-biru-50 dark:bg-biru-900">
                    <img src={b.thumbnail ?? GAMBAR_DEFAULT} alt="" loading="lazy" onerror={cadanganGambar} class="size-full object-cover" />
                  </a>
                  <div>
                    <a href={`/berita/${b.slug}`} class="line-clamp-2 text-sm font-semibold text-biru-900 hover:text-biru-600 dark:text-biru-100 dark:hover:text-white">
                      {b.judul}
                    </a>
                    <p class="mt-1 text-xs text-teks-lembut">{tanggalPanjang(b.tanggal)}</p>
                  </div>
                </li>
              ))}
            </ul>
          </aside>
        )}
      </div>
    </div>
  </article>

  <!-- Satu dialog untuk semua gambar sampul dan isi berita; klik di luar gambar untuk menutup. -->
  <dialog id="dialog-gambar" aria-label="Gambar diperbesar" class="dialog-halus m-auto max-h-none max-w-none overflow-visible bg-transparent p-0 [--pekat:0.92]">
    <img alt="" class="max-h-[calc(100dvh-2rem)] max-w-[calc(100vw-2rem)] rounded object-contain" />
    <form method="dialog">
      <button class="absolute top-2 right-2 flex size-10 items-center justify-center rounded bg-biru-950/70 text-white transition hover:bg-biru-950" aria-label="Tutup gambar">
        <Ikon nama="silang" class="size-5" />
      </button>
    </form>
  </dialog>
</Base>

<script>
  // Gambar sampul dan isi berita bisa diklik (atau Enter/Spasi) untuk dilihat besar.
  // Gambar yang dibungkus tautan tetap membuka tautannya.
  const dialogGambar = document.querySelector<HTMLDialogElement>('#dialog-gambar')!;
  const besar = dialogGambar.querySelector('img')!;
  let dibuka: HTMLImageElement | null = null;

  document.querySelectorAll<HTMLImageElement>('[data-perbesar] img:not([aria-hidden])').forEach((img) => {
    if (img.closest('a')) return;

    const buka = () => {
      dibuka = img;
      // Salinan di artikel sudah ada di cache, jadi langsung menggantikan gambar sebelumnya tanpa kedip.
      besar.removeAttribute('srcset');
      besar.src = img.currentSrc || img.src;
      besar.alt = img.alt;
      dialogGambar.showModal();

      // Versi terbesar yang pas di layar dimuat di belakang, baru dipasang setelah siap.
      if (!img.srcset) return;
      const muat = new Image();
      muat.sizes = besar.sizes = '100vw';
      muat.srcset = img.srcset;
      muat.onload = () => {
        if (dibuka === img) besar.srcset = img.srcset;
      };
    };

    img.tabIndex = 0;
    img.classList.add('cursor-zoom-in');
    img.addEventListener('click', buka);
    img.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        buka();
      }
    });
  });

  dialogGambar.addEventListener('click', (e) => e.target !== besar && dialogGambar.close());

  document.querySelectorAll<HTMLButtonElement>('[data-salin]').forEach((tombol) => {
    const label = tombol.querySelector('span')!;
    tombol.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(tombol.dataset.salin!);
        label.textContent = 'Tautan disalin';
      } catch {
        label.textContent = 'Gagal menyalin';
      }
      setTimeout(() => (label.textContent = 'Salin tautan'), 2000);
    });
  });
</script>
