---
import Ikon from '../../components/Ikon.astro';
import KartuBerita from '../../components/KartuBerita.astro';
import Base from '../../layouts/Base.astro';
import { api, tanggalPanjang, type Berita } from '../../lib/api';

type Detail = Berita & { konten: string; lainnya: Berita[] };

const { slug } = Astro.params;

let berita: Detail;

try {
  berita = await api<Detail>(`/berita/${slug}`, Astro.request);
} catch {
  return new Response(null, { status: 404, statusText: 'Berita tidak ditemukan' });
}
---

<Base judul={berita.judul} deskripsi={berita.ringkasan}>
  <article>
    <!-- Kepala artikel di atas latar biru, gaya sama dengan judul halaman lain. -->
    <header class="bg-biru-800 motif-komdigi text-white">
      <div class="wadah py-12 lg:py-16">
        <nav aria-label="Remah roti" class="mb-4">
          <ol class="flex flex-wrap items-center gap-2 text-xs text-biru-200">
            <li><a href="/" class="hover:text-white">Beranda</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/berita" class="hover:text-white">Berita</a></li>
          </ol>
        </nav>

        {berita.kategori && (
          <a href={`/berita?kategori=${berita.kategori.slug}`} class="mb-4 inline-block rounded bg-white/15 px-3 py-1 text-xs font-semibold">
            {berita.kategori.nama}
          </a>
        )}

        <h1 class="max-w-4xl text-3xl font-bold leading-tight tracking-tight lg:text-4xl">{berita.judul}</h1>

        <div class="mt-5 flex flex-wrap items-center gap-5 text-sm text-biru-200">
          <span class="flex items-center gap-2"><Ikon nama="kalender" class="size-4" />{tanggalPanjang(berita.tanggal)}</span>
          <span class="flex items-center gap-2"><Ikon nama="mata" class="size-4" />{berita.totalLihat} kali dibaca</span>
        </div>
      </div>
    </header>

    <div class="wadah py-12">
      <div class="grid gap-12 lg:grid-cols-[1fr_320px]">
        <div>
          {berita.thumbnail && (
            <img src={berita.thumbnail} alt="" class="mb-8 aspect-16/9 w-full rounded object-cover" />
          )}
          <div class="prosa max-w-none" set:html={berita.konten} />
        </div>

        {berita.lainnya.length > 0 && (
          <aside>
            <h2 class="mb-5 border-b border-biru-100 pb-3 font-bold text-biru-900">Berita Lainnya</h2>
            <ul class="space-y-5">
              {berita.lainnya.map((b) => (
                <li class="flex gap-4">
                  <a href={`/berita/${b.slug}`} class="size-20 shrink-0 overflow-hidden rounded bg-biru-50">
                    {b.thumbnail && <img src={b.thumbnail} alt="" loading="lazy" class="size-full object-cover" />}
                  </a>
                  <div>
                    <a href={`/berita/${b.slug}`} class="line-clamp-2 text-sm font-semibold text-biru-900 hover:text-biru-600">
                      {b.judul}
                    </a>
                    <p class="mt-1 text-xs text-teks-lembut">{tanggalPanjang(b.tanggal)}</p>
                  </div>
                </li>
              ))}
            </ul>
          </aside>
        )}
      </div>
    </div>
  </article>
</Base>
