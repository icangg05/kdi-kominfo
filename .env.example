APP_NAME="Dinas Kominfo Kota Kendari"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=db_kominfo
DB_USERNAME=kominfo
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Laravel Octane berjalan di atas FrankenPHP (Caddy embedded).
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false

# Alamat internal API yang dipanggil Astro saat SSR.
API_URL=http://app:8000

# Akun admin awal yang dibuat DatabaseSeeder (belum ada pembagian role).
ADMIN_EMAIL=diskominfokendari@gmail.com
ADMIN_PASSWORD=rahasia123
