---
interface Props {
  gambar: string[];
}

const { gambar } = Astro.props;
---

<!-- Latar hero: gambar bergantian di belakang lapisan biru Komdigi. -->
<div class="absolute inset-0 overflow-hidden" data-karusel>
  {gambar.map((src, i) => (
    <img
      src={src}
      alt=""
      aria-hidden="true"
      class:list={[
        'absolute inset-0 size-full object-cover transition-opacity duration-1000',
        i === 0 ? 'opacity-100' : 'opacity-0',
      ]}
      data-slide
    />
  ))}
  <div class="absolute inset-0 bg-linear-to-br from-biru-900/95 via-biru-800/90 to-biru-600/80"></div>
  <div class="absolute inset-0 motif-komdigi"></div>
</div>

<script>
  const slide = document.querySelectorAll<HTMLElement>('[data-karusel] [data-slide]');

  if (slide.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let aktif = 0;

    setInterval(() => {
      slide[aktif]?.classList.replace('opacity-100', 'opacity-0');
      aktif = (aktif + 1) % slide.length;
      slide[aktif]?.classList.replace('opacity-0', 'opacity-100');
    }, 6000);
  }
</script>
