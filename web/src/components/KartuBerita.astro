---
import Ikon from './Ikon.astro';
import { tanggalPanjang, type Berita } from '../lib/api';

interface Props {
  berita: Berita;
}

const { berita } = Astro.props;
---

<article class="group flex h-full flex-col overflow-hidden rounded-kartu border border-biru-100 bg-white transition hover:-translate-y-1 hover:shadow-xl hover:shadow-biru-950/10">
  <a href={`/berita/${berita.slug}`} class="block aspect-16/9 overflow-hidden bg-biru-50">
    {berita.thumbnail ? (
      <img
        src={berita.thumbnail}
        alt=""
        loading="lazy"
        class="size-full object-cover transition duration-500 group-hover:scale-105"
      />
    ) : (
      <span class="flex size-full items-center justify-center text-biru-300">
        <Ikon nama="foto" class="size-10" />
      </span>
    )}
  </a>

  <div class="flex flex-1 flex-col p-5">
    {berita.kategori && (
      <a
        href={`/berita?kategori=${berita.kategori.slug}`}
        class="mb-3 w-fit rounded-full bg-biru-50 px-3 py-1 text-xs font-semibold text-biru-700 hover:bg-biru-100"
      >
        {berita.kategori.nama}
      </a>
    )}

    <h3 class="mb-2 text-base font-semibold leading-snug text-biru-900">
      <a href={`/berita/${berita.slug}`} class="transition group-hover:text-biru-600">{berita.judul}</a>
    </h3>

    <p class="mb-4 line-clamp-3 text-sm text-teks-lembut">{berita.ringkasan}</p>

    <div class="mt-auto flex items-center gap-4 border-t border-biru-100 pt-3 text-xs text-teks-lembut">
      <span class="flex items-center gap-1.5">
        <Ikon nama="kalender" class="size-4" />
        {tanggalPanjang(berita.tanggal)}
      </span>
      <span class="flex items-center gap-1.5">
        <Ikon nama="mata" class="size-4" />
        {berita.totalLihat}
      </span>
    </div>
  </div>
</article>
