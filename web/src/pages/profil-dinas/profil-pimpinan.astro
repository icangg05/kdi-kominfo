---
import DialogGambar from '../../components/DialogGambar.astro';
import Ikon from '../../components/Ikon.astro';
import JudulHalaman from '../../components/JudulHalaman.astro';
import Base from '../../layouts/Base.astro';
import { api, cadanganGambar, GAMBAR_DEFAULT } from '../../lib/api';

type Data = {
  nama: string | null;
  jabatan: string | null;
  konten: string | null;
  foto: string | null;
  fotoTambahan: string[];
};

const data = await api<Data>('/profil-pimpinan', Astro.request);
---

<Base judul="Profil Pimpinan" deskripsi={`Profil ${data.nama ?? 'Kepala Dinas'} Kominfo Kota Kendari.`}>
  <JudulHalaman
    judul="Profil Pimpinan"
    keterangan="Profil Kepala Dinas Komunikasi dan Informatika Kota Kendari."
    remah={[{ label: 'Profil Dinas' }, { label: 'Profil Pimpinan' }]}
  />

  <div class="isolate overflow-x-clip">
    <div class="wadah py-12 lg:py-16">
      <div class="grid gap-12 lg:grid-cols-[19rem_minmax(0,1fr)] lg:gap-x-16 xl:gap-x-20">
        <!-- Kartu pimpinan sama dengan kartu sambutan di beranda (bidang langit, blok biru tergeser, dua siku),
             tapi kartunya tombol untuk memperbesar foto. -->
        <aside data-perbesar>
          <div class="group/potret relative mr-3 max-w-sm lg:mt-2 lg:max-w-none">
            <div class="absolute top-20 right-1/3 -bottom-8 -left-[50vw] -z-10 hidden bg-langit lg:block" aria-hidden="true"></div>
            <span class="absolute -top-4 -left-4 hidden size-12 border-t-2 border-l-2 border-biru-300 transition-[translate] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover/potret:-translate-1 lg:block dark:border-biru-700" aria-hidden="true"></span>
            <span class="absolute -right-7 -bottom-7 hidden size-12 border-r-2 border-b-2 border-biru-300 transition-[translate] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover/potret:translate-1 lg:block dark:border-biru-700" aria-hidden="true"></span>

            <button type="button" class="relative block w-full cursor-zoom-in rounded text-left">
              <span class="absolute inset-0 translate-3 rounded bg-biru-600 transition-[translate] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover/potret:translate-4.5" aria-hidden="true"></span>
              <span class="relative grid overflow-hidden rounded bg-biru-800 text-white transition-[translate] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover/potret:-translate-1.5 group-active/potret:translate-0">
                <span class="block overflow-hidden bg-biru-900">
                  <img
                    src={data.foto ?? GAMBAR_DEFAULT}
                    alt={`Foto ${data.nama ?? 'pimpinan'}`}
                    onerror={cadanganGambar}
                    class="aspect-4/5 size-full object-cover transition-[scale] duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover/potret:scale-105"
                  />
                </span>
                <span class="motif-komdigi flex items-center gap-4 p-4 lg:p-5">
                  <span class="min-w-0 flex-1">
                    <span class="sr-only">Perbesar foto: </span>
                    <span class="block leading-snug font-bold text-balance">{data.nama}</span>
                    {data.jabatan && <span class="mt-1 block text-sm text-biru-200">{data.jabatan}</span>}
                  </span>
                  <span class="flex size-9 shrink-0 items-center justify-center rounded border border-white/40 transition group-hover/potret:border-white group-hover/potret:bg-white group-hover/potret:text-biru-800" aria-hidden="true">
                    <Ikon nama="cari" class="size-4" />
                  </span>
                </span>
              </span>
            </button>
          </div>

          <!-- Foto tambahan terangkat saat hover tanpa pembungkus overflow-hidden, supaya cincin fokus keyboard tidak terpotong. -->
          {data.fotoTambahan.length > 0 && (
            <div class="mt-10 grid max-w-sm grid-cols-3 gap-3 lg:mt-16 lg:max-w-none">
              {data.fotoTambahan.map((f, i) => (
                <img
                  src={f}
                  alt={`Foto ${data.nama ?? 'pimpinan'} ${i + 2}`}
                  loading="lazy"
                  class="aspect-square w-full rounded object-cover transition-[translate,box-shadow,filter] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1.5 hover:brightness-105 hover:bayangan-kartu"
                />
              ))}
            </div>
          )}
        </aside>

        {data.konten && <div class="prosa lg:mt-2" set:html={data.konten} />}
      </div>
    </div>
  </div>

  <DialogGambar />
</Base>
