---
import Ikon from './Ikon.astro';
---

<!-- Satu dialog rincian untuk semua tombol [data-dokumen]; isinya disalin dari JSON di tombol (lihat rincianDokumen). -->
<dialog
  id="dialog-dokumen"
  aria-labelledby="dialog-dokumen-judul"
  class="dialog-halus m-auto max-h-[calc(100dvh-2rem)] w-[min(36rem,calc(100vw-2rem))] max-w-none overflow-y-auto rounded bg-white p-0 text-left text-teks shadow-[0_24px_60px_-20px_rgba(7,31,61,0.5)] dark:bg-malam-kartu"
>
  <div class="flex items-start gap-4 border-b border-garis p-6">
    <span class="flex h-12 w-10 shrink-0 items-center justify-center rounded bg-biru-600 text-[11px] font-bold text-white uppercase" data-isi="ekstensi"></span>
    <div class="min-w-0 flex-1">
      <p class="mb-1 text-xs font-semibold text-biru-600 empty:hidden dark:text-biru-300" data-isi="kategori"></p>
      <h2 id="dialog-dokumen-judul" class="text-lg leading-snug font-bold text-biru-900 dark:text-white" data-isi="judul"></h2>
    </div>
    <form method="dialog">
      <button class="-mt-1 -mr-2 flex size-9 items-center justify-center rounded text-teks-lembut transition hover:bg-biru-50 hover:text-biru-900 dark:hover:bg-white/5 dark:hover:text-white" aria-label="Tutup rincian">
        <Ikon nama="silang" class="size-5" />
      </button>
    </form>
  </div>

  <div class="p-6">
    <p class="text-sm leading-relaxed whitespace-pre-line text-teks-lembut" data-isi="deskripsi"></p>

    <dl class="mt-6 grid grid-cols-2 gap-x-6 gap-y-4 rounded bg-biru-50 p-4 text-sm sm:grid-cols-4 dark:bg-biru-900/40">
      <div>
        <dt class="text-xs text-teks-lembut">Format</dt>
        <dd class="mt-0.5 font-semibold uppercase" data-isi="ekstensi"></dd>
      </div>
      <div>
        <dt class="text-xs text-teks-lembut">Ukuran</dt>
        <dd class="mt-0.5 font-semibold tabular-nums" data-isi="ukuran"></dd>
      </div>
      <div>
        <dt class="text-xs text-teks-lembut">Diunggah</dt>
        <dd class="mt-0.5 font-semibold" data-isi="tanggal"></dd>
      </div>
      <div>
        <dt class="text-xs text-teks-lembut">Diunduh</dt>
        <dd class="mt-0.5 font-semibold tabular-nums" data-isi="unduhan"></dd>
      </div>
    </dl>

    <a href="#" class="mt-6 inline-flex items-center gap-2 rounded bg-biru-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-biru-700" data-unduh>
      <Ikon nama="unduh" class="size-4" />
      Unduh dokumen
    </a>
  </div>
</dialog>

<script>
  const dialogDokumen = document.querySelector<HTMLDialogElement>('#dialog-dokumen')!;

  document.querySelectorAll<HTMLElement>('[data-dokumen]').forEach((tombol) =>
    tombol.addEventListener('click', () => {
      const d: Record<string, string> = JSON.parse(tombol.dataset.dokumen!);
      dialogDokumen.querySelectorAll<HTMLElement>('[data-isi]').forEach((el) => (el.textContent = d[el.dataset.isi!] ?? ''));
      dialogDokumen.querySelector<HTMLAnchorElement>('[data-unduh]')!.href = d.unduh;
      dialogDokumen.showModal();
    }),
  );

  // Klik di latar gelap (di luar isi dialog) menutup dialog.
  dialogDokumen.addEventListener('click', (e) => e.target === dialogDokumen && dialogDokumen.close());
</script>
