---
import DialogGambar from '../components/DialogGambar.astro';
import JudulHalaman from '../components/JudulHalaman.astro';
import KosongAda from '../components/KosongAda.astro';
import Paginasi from '../components/Paginasi.astro';
import TabGaleri from '../components/TabGaleri.astro';
import Base from '../layouts/Base.astro';
import { api, cadanganGambar, GAMBAR_DEFAULT, query, tanggalPanjang, type Halaman } from '../lib/api';

type Foto = { judul: string; tanggal: string | null; gambar: string | null };

const page = Number(Astro.url.searchParams.get('page') ?? 1) || 1;
const daftar = await api<Halaman<Foto>>(`/galeri${query({ page })}`, Astro.request);
---

<Base judul="Galeri Foto" deskripsi="Dokumentasi foto kegiatan Diskominfo Kota Kendari.">
  <JudulHalaman
    judul="Galeri Foto"
    keterangan="Dokumentasi kegiatan dan layanan Diskominfo Kota Kendari."
    remah={[{ label: 'Galeri' }, { label: 'Foto' }]}
  />

  <div class="wadah py-12">
    <TabGaleri aktif="foto" />

    {daftar.data.length > 0 ? (
      <>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-perbesar>
          {daftar.data.map((f) => (
            <figure class="group relative aspect-4/3 overflow-hidden rounded bg-biru-900 bayangan-kartu">
              <img src={f.gambar ?? GAMBAR_DEFAULT} alt={f.judul} data-judul={f.judul} data-tanggal={tanggalPanjang(f.tanggal)} loading="lazy" onerror={cadanganGambar} class="absolute inset-0 size-full object-cover transition duration-500 group-hover:scale-105 focus-visible:-outline-offset-2" />
              <!-- Scrim pekat (≥85%) di sepanjang area teks, baru memudar di atasnya, supaya teks tetap terbaca di foto terang. -->
              <figcaption class="pointer-events-none absolute inset-x-0 bottom-0 bg-linear-to-t from-biru-950 via-biru-950/85 via-55% to-transparent p-4 pt-16 text-white">
                <p class="line-clamp-2 text-sm leading-snug font-semibold tracking-wide uppercase">{f.judul}</p>
                <p class="mt-1 text-xs text-biru-200">{tanggalPanjang(f.tanggal)}</p>
              </figcaption>
            </figure>
          ))}
        </div>
        <Paginasi halaman={daftar.meta.page} halamanTerakhir={daftar.meta.lastPage} />
      </>
    ) : (
      <KosongAda pesan="Belum ada foto di galeri." />
    )}
  </div>

  <DialogGambar />
</Base>
